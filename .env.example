# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# APLICAÇÃO
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
SECRET_KEY=troque-por-uma-chave-aleatoria-forte-minimo-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# BANCO DE DADOS
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
MONGODB_URI=mongodb+srv://usuario:senha@cluster.mongodb.net
DATABASE_NAME=sentimento_db
SECONDARY_MONGODB_URI=mongodb+srv://usuario:senha@cluster.mongodb.net
SECONDARY_DATABASE_NAME=sentimento_demo_db

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# CORS — apenas origens de produção
# Separar por vírgula, sem espaços, sem barra final
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
CORS_ORIGINS_CSV=https://sentimento-ai.netlify.app

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# FRONTEND — usado nos links de e-mail (reset de senha, etc.)
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
FRONTEND_URL=https://sentimento-ai.netlify.app

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# LLM — Ollama externo (HTTP). Sem modelo local.
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
OLLAMA_BASE_URL=https://sua-instancia-ollama.com
OLLAMA_API_KEY=
OLLAMA_MODEL=llama3
OLLAMA_TIMEOUT_SECONDS=120

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# SCRAPER — todos os timeouts e limites pelo .env
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
SCRAPER_TIMEOUT_SECONDS=30
SCRAPER_RETRY_ATTEMPTS=2
SCRAPER_RETRY_BACKOFF_SECONDS=2
SCRAPER_REQUEST_DELAY_SECONDS=1
SCRAPER_MIN_TEXT_LENGTH=20
SCRAPER_DEFAULT_LIMIT=10
SCRAPER_MAX_ITEMS_PER_SOURCE=20
SCRAPER_MAX_TOTAL_ITEMS=100

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# FEATURES
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
ENABLE_RECLAME_AQUI=true
ENABLE_PLAYWRIGHT=false

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# CACHE
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
CACHE_TTL_MINUTES=60

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# EMAIL (SMTP)
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
SMTP_HOST=smtp.seuprovedor.com
SMTP_PORT=587
SMTP_USER=seu@email.com
SMTP_PASSWORD=sua-senha-smtp
SMTP_FROM_EMAIL=noreply@seudominio.com
SMTP_FROM_NAME=SentimentoIA

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# LLM THRESHOLDS
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
LLM_TRIGGER_MIN_COMMENTS=5
LLM_MAX_SAMPLE_MENTIONS=20
BATCH_SIZE=50
MAX_TEXT_LENGTH=5000

# Thresholds de urgência (0.0 a 1.0)
URGENCY_THRESHOLD_CRITICAL=0.80
URGENCY_THRESHOLD_HIGH=0.60
URGENCY_THRESHOLD_MEDIUM=0.35

# Padrões linguísticos de risco alto (separados por |)
URGENCY_PATTERNS_CRITICAL=cancelamento|processo judicial|procon|fraude|golpe|advogado|ação legal|estorno forçado|chargeback
URGENCY_PATTERNS_HIGH=nunca mais|horrível|absurdo|cadê meu dinheiro|não funciona|terceira vez|problema recorrente|sem resposta|ignorado
URGENCY_PATTERNS_MEDIUM=insatisfeito|demora|atraso|decepcionado|esperava mais|ruim|poderia melhorar

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# NPS
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
NPS_ENABLED=true
NPS_COOLDOWN_DAYS=30
NPS_MIN_INTERACTIONS=5

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# LOGS
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
LOG_LEVEL=INFO

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# LGPD
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
DATA_RETENTION_YEARS=2
PRIVACY_CONTACT_EMAIL=privacidade@seudominio.com

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# AUTO REFRESH (experimental)
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
AUTO_REFRESH_ENABLED=false
AUTO_REFRESH_INTERVAL_MINUTES=60

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# Rate limiting (requests por minuto por usuário autenticado)
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
RATE_LIMIT_SEARCH_PER_MINUTE=5
RATE_LIMIT_SCRAPE_PER_MINUTE=3
RATE_LIMIT_ANALYZE_PER_MINUTE=10
