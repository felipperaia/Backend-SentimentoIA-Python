ENV=development
DEBUG=true
APP_NAME=SentimentoIA API
APP_URL=https://api.seudominio.com
FRONTEND_URL=https://app.seudominio.com
CORS_ORIGINS_CSV=

SECRET_KEY=change-me
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/
DATABASE_NAME=sentimento_db

LLM_PROVIDER=ollama
OLLAMA_BASE_URL=https://ollama.com/api
OLLAMA_API_KEY=
OLLAMA_MODEL=llama3.1:8b
OLLAMA_TIMEOUT_SECONDS=60

SCRAPER_DEFAULT_SOURCES=reclameaqui,reddit,web
SCRAPER_DEFAULT_LIMIT=5
SCRAPER_MAX_ITEMS_PER_SOURCE=10
SCRAPER_MAX_TOTAL_ITEMS=50

WORKER_POLL_INTERVAL_SECONDS=5
WORKER_BATCH_SIZE=50
LLM_TRIGGER_MIN_COMMENTS=20
LLM_MAX_SAMPLE_MENTIONS=40
LOG_LEVEL=INFO

ENABLE_EXPORTS=true
ENABLE_CHAT=true
ENABLE_INGESTION_API=true
