# App
SECRET_KEY=change-me-with-a-strong-random-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# MongoDB primary (read/write source of truth)
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net
DATABASE_NAME=sentimento_db

# MongoDB secondary (ingestion staging only)
SECONDARY_MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net
SECONDARY_DATABASE_NAME=sentimento_staging_db

# Frontend and CORS
CORS_ORIGINS_CSV=https://sentimento-ai.netlify.app
FRONTEND_URL=https://sentimento-ai.netlify.app

# LLM (Ollama HTTP)
OLLAMA_BASE_URL=https://your-ollama-host
OLLAMA_API_KEY=
OLLAMA_MODEL=llama3
OLLAMA_TIMEOUT_SECONDS=120

# SMTP
SMTP_HOST=smtp.provider.com
SMTP_PORT=587
SMTP_USER=user@domain.com
SMTP_PASSWORD=change-me
SMTP_FROM_EMAIL=noreply@domain.com
SMTP_FROM_NAME=SentimentoIA

# LLM / processing
LLM_TRIGGER_MIN_COMMENTS=5
LLM_MAX_SAMPLE_MENTIONS=20
BATCH_SIZE=50
MAX_TEXT_LENGTH=5000

# Urgency engine
URGENCY_THRESHOLD_CRITICAL=0.80
URGENCY_THRESHOLD_HIGH=0.60
URGENCY_THRESHOLD_MEDIUM=0.35
URGENCY_PATTERNS_CRITICAL=cancelamento|processo judicial|procon|fraude|golpe|advogado|acao legal|estorno forcado|chargeback
URGENCY_PATTERNS_HIGH=nunca mais|horrivel|absurdo|cade meu dinheiro|nao funciona|terceira vez|problema recorrente|sem resposta|ignorado
URGENCY_PATTERNS_MEDIUM=insatisfeito|demora|atraso|decepcionado|esperava mais|ruim|poderia melhorar

# NPS
NPS_ENABLED=true
NPS_COOLDOWN_DAYS=30
NPS_MIN_INTERACTIONS=5

# Security / governance
LOG_LEVEL=INFO
DATA_RETENTION_YEARS=2
PRIVACY_CONTACT_EMAIL=privacy@domain.com

# Optional background refresh flag
AUTO_REFRESH_ENABLED=false

# Rate limiting
RATE_LIMIT_SEARCH_PER_MINUTE=5
RATE_LIMIT_ANALYZE_PER_MINUTE=10
