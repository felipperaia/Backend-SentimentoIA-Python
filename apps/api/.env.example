# ==========================================
# Ambiente
# ==========================================
ENV=development
DEBUG=true
LOG_LEVEL=INFO

# ==========================================
# Core app e seguranca
# ==========================================
FRONTEND_URL=https://app.seudominio.com
CORS_ORIGINS_CSV=https://app.seudominio.com
SECRET_KEY=change-me-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30
PUBLIC_ERROR_VERBOSE=false
ENABLE_DEV_CLEAR_DATA=false

# ==========================================
# MongoDB
# ==========================================
MONGODB_URI=mongodb://localhost:27017
DATABASE_NAME=sentimento_db

# ==========================================
# Ollama (direto)
# ==========================================
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=https://ollama.seudominio.com
OLLAMA_API_KEY=
OLLAMA_MODEL=llama3.1:8b
OLLAMA_TIMEOUT_SECONDS=60
LLM_TRIGGER_MIN_COMMENTS=20
LLM_MAX_SAMPLE_MENTIONS=40

# ==========================================
# SMTP
# ==========================================
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_FROM_NAME=SentimentoIA
SMTP_USE_TLS=true
SMTP_USE_SSL=false

# ==========================================
# Scraping e fontes
# ==========================================
SCRAPER_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/124.0.0.0 Safari/537.36
SCRAPER_DELAY_SECONDS=5
SCRAPER_TIMEOUT_SECONDS=20
SCRAPER_DEFAULT_LIMIT=5
SCRAPER_DEFAULT_SOURCES=reclameaqui,reddit,web
SCRAPER_MAX_ITEMS_PER_SOURCE=10
SCRAPER_MAX_TOTAL_ITEMS=50
SCRAPER_MAX_PAGES_PER_SOURCE=2
SCRAPER_RETRY_ATTEMPTS=3
SCRAPER_RETRY_BACKOFF_SECONDS=1
SCRAPER_RECLAMEAQUI_URL=https://www.reclameaqui.com.br
SCRAPER_REDDIT_URL=https://www.reddit.com
SCRAPER_MASTODON_BASE_URL=https://mastodon.social
SCRAPER_WEB_SEARCH_URL=https://duckduckgo.com/html/
ENABLE_RECLAME_AQUI=false
ENABLE_PLAYWRIGHT=false
APIFY_TOKEN=

# ==========================================
# Worker e cache
# ==========================================
WORKER_POLL_INTERVAL_SECONDS=5
WORKER_BATCH_SIZE=50
CACHE_TTL_MINUTES=30
AUTO_REFRESH_ENABLED=false
AUTO_REFRESH_INTERVAL_MINUTES=60

# ==========================================
# NPS
# ==========================================
NPS_ENABLED=true
NPS_COOLDOWN_DAYS=7
NPS_MIN_INTERACTIONS=5

# ==========================================
# LGPD
# ==========================================
PRIVACY_CONTACT_EMAIL=privacidade@sentimentoia.com
DATA_RETENTION_YEARS=2
