ENV=development
DEBUG=true
APP_NAME=SentimentoIA API
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000
SECRET_KEY=change-me
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=no-reply@sentimentoia.local
SMTP_FROM_EMAIL=no-reply@sentimentoia.local
SMTP_FROM_NAME=SentimentoIA
SMTP_USE_TLS=true
SMTP_USE_SSL=false

MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/
DATABASE_NAME=sentimento_db

# === Ollama Cloud (LLM) ===
LLM_PROVIDER=ollama
# Base URL do Ollama Cloud. Pode terminar com /api ou nao — o sistema normaliza.
OLLAMA_BASE_URL=https://ollama.com/api
OLLAMA_API_KEY=
OLLAMA_MODEL=llama3.1:8b
OLLAMA_TIMEOUT_SECONDS=60

# === Scraping ===
SCRAPER_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/124.0.0.0 Safari/537.36
SCRAPER_DELAY_SECONDS=1.0
SCRAPER_TIMEOUT_SECONDS=20
SCRAPER_DEFAULT_LIMIT=5
SCRAPER_DEFAULT_SOURCES=reclameaqui,reddit,mastodon,web
SCRAPER_MAX_ITEMS_PER_SOURCE=10
SCRAPER_MAX_TOTAL_ITEMS=50
SCRAPER_MAX_PAGES_PER_SOURCE=2
SCRAPER_RETRY_ATTEMPTS=3
SCRAPER_RETRY_BACKOFF_SECONDS=1.0
SCRAPER_MIN_TEXT_LENGTH=20
SCRAPER_RECLAMEAQUI_URL=https://www.reclameaqui.com.br
SCRAPER_RECLAMEAQUI_SEARCH_URL=https://www.reclameaqui.com.br/busca/?q=
SCRAPER_REDDIT_URL=https://www.reddit.com
SCRAPER_MASTODON_BASE_URL=https://mastodon.social
SCRAPER_MASTODON_SEARCH_PATH=/api/v2/search
# Token opcional para melhorar resultados do Mastodon (sem ele, modo publico restrito)
SCRAPER_MASTODON_ACCESS_TOKEN=
SCRAPER_WEB_SEARCH_URL=https://duckduckgo.com/html/

# === LLM Thresholds ===
LLM_TRIGGER_MIN_COMMENTS=20
LLM_MAX_SAMPLE_MENTIONS=40

# === NPS (Net Promoter Score) ===
NPS_ENABLED=true
NPS_COOLDOWN_DAYS=7
NPS_MIN_INTERACTIONS=5

# === Dev/Debug ===
ENABLE_DEV_CLEAR_DATA=false
PUBLIC_ERROR_VERBOSE=false
ENABLE_EXPORTS=true
ENABLE_CHAT=true
ENABLE_INGESTION_API=true
