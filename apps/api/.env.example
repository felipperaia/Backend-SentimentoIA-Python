ENV=development
DEBUG=true
APP_NAME=SentimentoIA API
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000
SECRET_KEY=change-me
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/
DATABASE_NAME=sentimento_db

LLM_PROVIDER=ollama
OLLAMA_MODE=local
OLLAMA_LOCAL_URL=http://localhost:11434
OLLAMA_CLOUD_URL=https://SEU-ENDPOINT-CLOUD
OLLAMA_API_KEY=
OLLAMA_MODEL=llama3.1:8b

LLM_TRIGGER_MIN_COMMENTS=20
LLM_MAX_SAMPLE_MENTIONS=40

ENABLE_DEV_CLEAR_DATA=false
PUBLIC_ERROR_VERBOSE=false
ENABLE_EXPORTS=true
ENABLE_CHAT=true
ENABLE_INGESTION_API=true
